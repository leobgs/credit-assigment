{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=kredit_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "SuperSecretKeyForJwtAuthenticationMustBeAtLeast32CharsLong!",
    "Issuer": "PengajuanKredit",
    "Audience": "PengajuanKreditUsers",
    "ExpireMinutes": 60
  },
  "Auth": {
    "Username": "admin",
    "Password": "Password123!"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
